/dist/
/target/
/src/wasm/generated/v1/guest/target/
/tools/wasm-abi-generator/target/
/benchmarks/wasm-sketch/component-guest/target/
/benchmarks/wasm-sketch/component-tools/target/
/guests/threaded-smoke/target/
/.extern-repos/
*.egg-info/
__pycache__/
# Separate workspaces: each builds into a target directory beside its manifest.
/tests/*-consumer/target/
# Running `scripts/build-threaded-smoke.*` locally puts a Cargo home beside the
# guest manifest. Only the checked-in target config belongs to the repository.
/guests/threaded-smoke/.cargo/*
!/guests/threaded-smoke/.cargo/config.toml
/examples/wasm-tauri-screenshot/guest/target/
/examples/wasm-tauri-screenshot/guest/.cargo/*
!/examples/wasm-tauri-screenshot/guest/.cargo/config.toml

# macOS x86_64 guest lane: the staged share payload and the cross-built archive.
/share/
/kernal-x64.tar.zst
# setup-soldr writes its cache archives into the checkout root.
/target.soldr-*

# Dylint workspaces build beside their manifests. A local run with the Cargo
# home beside the manifest leaves caches there too; only the checked-in
# `.cargo/config.toml` belongs to the repository.
/dylints/*/target/
/dylints/*/.cargo/*
!/dylints/*/.cargo/config.toml
